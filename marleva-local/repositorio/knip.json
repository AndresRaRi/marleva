{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs}", "tests/**/*.{mjs,ts}"],
      "project": ["scripts/*.{mjs,cjs}", "tests/**/*.{mjs,ts}"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "bootstrap.mjs", "seed.mjs", "src/m3-main.ts"],
      "project": ["src/**/*.ts", "*.mjs", "prisma/**/*.prisma"],
      "ignoreDependencies": ["@prisma/client"]
    },
    "apps/client": {
      "entry": ["app/**/*.{ts,tsx}", "m3/index.ts", "src/modules/m3/generated/api.ts"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "m3/**/*.{ts,tsx}"],
      "ignoreDependencies": ["expo-updates"]
    },
    "packages/contracts": {
      "entry": ["generated.ts"]
    }
  },
  "ignoreBinaries": ["openssl", "adb"],
  "ignoreUnresolved": ["./scripts/tool"]
}
