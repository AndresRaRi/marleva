{
  "name": "marleva-local",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "pnpm --filter @marleva/api build && pnpm --filter @marleva/client build",
    "test": "pnpm test:unit && pnpm test:integration",
    "typecheck": "pnpm --filter @marleva/api typecheck && pnpm --filter @marleva/client typecheck",
    "contracts": "pnpm --filter @marleva/contracts generate",
    "docs:generate": "node scripts/generate-documentation.mjs && pnpm contracts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration/backend --exclude \"**/data-target.test.mjs\" --exclude \"**/outbox.test.mjs\" --exclude \"**/files.test.mjs\" --exclude \"**/otp-quota.test.mjs\"",
    "test:outbox": "vitest run tests/integration/backend/M1/outbox.test.mjs",
    "test:frontend:integration": "node tests/integration/frontend/M1/web-test.mjs",
    "test:performance:backend": "node tests/performance/backend/M1/health.mjs",
    "test:performance:frontend": "node tests/performance/frontend/M1/navigation.mjs",
    "test:schema": "vitest run tests/integration/backend/M1/data-target.test.mjs",
    "docs:target": "node scripts/generate-m1-target.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,cjs,json}\" \"scripts/*.{mjs,cjs}\" \"tests/**/*.{ts,mjs}\" eslint.config.mjs .prettierrc.json package.json",
    "quality": "pnpm typecheck && node scripts/check-lint-controls.mjs && pnpm lint && pnpm format:check && node scripts/check-unused.mjs",
    "test:files": "vitest run tests/integration/backend/M1/files.test.mjs",
    "test:quota": "vitest run tests/integration/backend/M1/otp-quota.test.mjs",
    "test:coverage": "vitest run --config vitest.coverage.config.mjs --coverage",
    "arch:check": "pnpm exec depcruise apps/api/src --config .dependency-cruiser.cjs && pnpm exec jscpd",
    "contracts:check": "pnpm exec redocly lint docs/apis/M1/openapi.yaml && pnpm docs:target && pnpm docs:generate && git diff --exit-code -- docs/modelado-datos/ddl docs/apis/M1 packages/contracts packages/config/http-routes.json",
    "ci:prepare": "node scripts/ci-prepare.mjs",
    "ci:run": "node scripts/ci-stage.mjs",
    "ci:summary": "node scripts/ci-summary.mjs",
    "coverage:check": "node scripts/coverage-ratchet.mjs",
    "build:container": "node scripts/container-build.mjs",
    "ci:tool": "node scripts/ci-tool.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "ci:stack:start": "node scripts/ci-stack.mjs start",
    "ci:stack:stop": "node scripts/ci-stack.mjs stop",
    "ci:migrations": "node scripts/ci-migrations.mjs",
    "ci:integration": "node scripts/ci-integration.mjs backend",
    "test:e2e": "node scripts/ci-integration.mjs web",
    "contracts:fuzz": "node scripts/ci-integration.mjs contract",
    "ci:cert-trust": "node scripts/ci-cert-trust.mjs",
    "test:recovery:ci": "MARLEVA_RECOVERY_CHECK=1 MARLEVA_ENV_FILE=artifacts/ci/stack/.env.operators node tests/integration/backend/M1/recovery-api.mjs",
    "ci:sonar": "node scripts/sonar-cloud.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.13.0",
    "@dbml/core": "10.3.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@redocly/cli": "2.63.0",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "1.0.4",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "otplib": "13.5.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "swagger-ui-dist": "5.33.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "xcode": "3.0.1",
    "yaml": "2.9.1",
    "@eslint/compat": "2.1.1"
  }
}
