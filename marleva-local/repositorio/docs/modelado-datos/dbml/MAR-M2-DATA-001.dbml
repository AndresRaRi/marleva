Ref m2_version_source_decision: marleva.M2MembershipVersion.(sourceDecisionId, sourceSubmissionId, applicationId, accountId) > marleva.M2MembershipDecision.(id, submissionId, applicationId, accountId) [delete: no action, update: no action]
Ref m2_version_source_submission: marleva.M2MembershipVersion.(sourceSubmissionId, applicationId, accountId) > marleva.M2MembershipSubmission.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_application_current_version: marleva.M2MembershipApplication.(currentVersionId, id, accountId) > marleva.M2MembershipVersion.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_version_private: marleva.M2MembershipVersionPrivate.(versionId, applicationId, accountId) > marleva.M2MembershipVersion.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_document_application: marleva.M2MembershipDocument.(applicationId, accountId) > marleva.M2MembershipApplication.(id, accountId) [delete: no action, update: no action]
Ref m2_link_version: marleva.M2MembershipVersionDocument.(versionId, applicationId, accountId) > marleva.M2MembershipVersion.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_link_document: marleva.M2MembershipVersionDocument.(documentId, applicationId, accountId, purpose) > marleva.M2MembershipDocument.(id, applicationId, accountId, purpose) [delete: no action, update: no action]
Ref m2_submission_version: marleva.M2MembershipSubmission.(versionId, applicationId, accountId) > marleva.M2MembershipVersion.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m8_assignment_submission: marleva.M8MembershipAssignment.(submissionId, applicationId, accountId) > marleva.M2MembershipSubmission.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m8_assignment_reviewer_grant: marleva.M8MembershipAssignment.(reviewerGrantId, reviewerId, reviewerCapability) > marleva.M8MembershipReviewGrant.(id, accountId, capability) [delete: no action, update: no action]
Ref m8_assignment_manager_grant: marleva.M8MembershipAssignment.(managerGrantId, assignedBy, managerCapability) > marleva.M8MembershipReviewGrant.(id, accountId, capability) [delete: no action, update: no action]
Ref m2_decision_assignment: marleva.M2MembershipDecision.(assignmentId, submissionId, applicationId, accountId, reviewerId) > marleva.M8MembershipAssignment.(id, submissionId, applicationId, accountId, reviewerId) [delete: no action, update: no action]
Ref m2_decision_private: marleva.M2MembershipDecisionPrivate.(decisionId, applicationId, accountId) > marleva.M2MembershipDecision.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_document_retention_decision: marleva.M2MembershipDocument.(retentionDecisionId, applicationId, accountId) > marleva.M2MembershipDecision.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_access_version_document: marleva.M2MembershipDocumentAccess.(versionId, documentId, applicationId, accountId) > marleva.M2MembershipVersionDocument.(versionId, documentId, applicationId, accountId) [delete: no action, update: no action]
Ref m2_access_submission_version: marleva.M2MembershipDocumentAccess.(submissionId, versionId, applicationId, accountId) > marleva.M2MembershipSubmission.(id, versionId, applicationId, accountId) [delete: no action, update: no action]
Ref m2_access_assignment_reviewer: marleva.M2MembershipDocumentAccess.(assignmentId, submissionId, applicationId, accountId, accessorId) > marleva.M8MembershipAssignment.(id, submissionId, applicationId, accountId, reviewerId) [delete: no action, update: no action]
Ref m2_event_submission: marleva.M2MembershipEvent.(submissionId, applicationId, accountId) > marleva.M2MembershipSubmission.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_event_decision: marleva.M2MembershipEvent.(decisionId, submissionId, applicationId, accountId) > marleva.M2MembershipDecision.(id, submissionId, applicationId, accountId) [delete: no action, update: no action]
Ref m2_receipt_application: marleva.M2MembershipCommandReceipt.(applicationId, accountId) > marleva.M2MembershipApplication.(id, accountId) [delete: no action, update: no action]
