Ref m2_event_recipient: marleva.M2MembershipEvent.recipientId > marleva.Account.id [delete: no action, update: no action]
Ref m2_receipt_actor: marleva.M2MembershipCommandReceipt.actorId > marleva.Account.id [delete: no action, update: no action]

// Compuestos: ninguna evidencia, versión, asignación o decisión de otro titular.
