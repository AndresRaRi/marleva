// D08/D09 v0.1 propuesto. Integridad declarativa, no política activada.
Table marleva.M2MembershipRetentionCase {
 id uuid [pk, not null]
 applicationId uuid [not null]
 accountId uuid [not null]
 resourceType text [not null]
 anchorSellerDecisionId uuid
 anchorRestrictionDecisionId uuid
 anchorDecisionId uuid
 documentId uuid
 documentPurpose text
 versionId uuid
 decisionId uuid
 sellerVersionId uuid
 sellerDecisionId uuid
 restrictionId uuid
 restrictionAppealId uuid
 restrictionDecisionId uuid
 policyVersion text [not null, default: 'D08-0.2']
 state text [not null, default: 'uncalculated']
 basisCode text [not null]
 startedAt timestamptz
 dueAt timestamptz
 completedAt timestamptz
 revision integer [not null, default: 1]
 indexes {
  (id, applicationId, accountId) [unique, name: 'm2_retention_owner_key']
  (documentId) [unique, name: 'm2_retention_document_key']
  (versionId) [unique, name: 'm2_retention_version_key']
  (decisionId) [unique, name: 'm2_retention_decision_key']
  (sellerVersionId) [unique, name: 'm2_case_sellerversionid_key']
  (sellerDecisionId) [unique, name: 'm2_case_sellerdecisionid_key']
  (restrictionId) [unique, name: 'm2_case_restrictionid_key']
  (restrictionAppealId) [unique, name: 'm2_case_restrictionappealid_key']
  (restrictionDecisionId) [unique, name: 'm2_case_restrictiondecisionid_key']
  (state, dueAt, id) [name: 'm2_retention_due_idx']
 }
 checks {
  `num_nonnulls("anchorDecisionId","anchorSellerDecisionId","anchorRestrictionDecisionId") <= 1` [name: 'm2_retention_single_anchor']
  `("anchorDecisionId" IS NULL OR "resourceType" IN ('document','version_private','decision_private')) AND ("anchorSellerDecisionId" IS NULL OR "resourceType" IN ('seller_version_private','seller_decision_private')) AND ("anchorRestrictionDecisionId" IS NULL OR "resourceType" IN ('restriction_private','restriction_appeal_private','restriction_decision_private'))` [name: 'm2_retention_anchor_kind']
  `("resourceType" = 'document' AND "documentId" IS NOT NULL AND "versionId" IS NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NOT NULL) OR ("resourceType" = 'version_private' AND "documentId" IS NULL AND "versionId" IS NOT NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NULL) OR ("resourceType" = 'decision_private' AND "documentId" IS NULL AND "versionId" IS NULL AND "decisionId" IS NOT NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NULL) OR ("resourceType" = 'seller_version_private' AND "documentId" IS NULL AND "versionId" IS NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NOT NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NULL) OR ("resourceType" = 'seller_decision_private' AND "documentId" IS NULL AND "versionId" IS NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NOT NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NULL) OR ("resourceType" = 'restriction_private' AND "documentId" IS NULL AND "versionId" IS NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NOT NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NULL) OR ("resourceType" = 'restriction_appeal_private' AND "documentId" IS NULL AND "versionId" IS NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NOT NULL AND "restrictionDecisionId" IS NULL AND "documentPurpose" IS NULL) OR ("resourceType" = 'restriction_decision_private' AND "documentId" IS NULL AND "versionId" IS NULL AND "decisionId" IS NULL AND "sellerVersionId" IS NULL AND "sellerDecisionId" IS NULL AND "restrictionId" IS NULL AND "restrictionAppealId" IS NULL AND "restrictionDecisionId" IS NOT NULL AND "documentPurpose" IS NULL)` [name: 'm2_retention_typed_target']
  `state NOT IN ('scheduled','delete_pending','deleted','error') OR ("startedAt" IS NOT NULL AND "dueAt" IS NOT NULL)` [name: 'm2_retention_schedule_required']
  `"completedAt" IS NULL OR ("dueAt" IS NOT NULL AND "completedAt" >= "dueAt")` [name: 'm2_retention_completion_date']
  `state IN ('uncalculated','scheduled','held','delete_pending','deleted','error') AND revision > 0` [name: 'm2_retention_state']
  `("startedAt" IS NULL AND "dueAt" IS NULL) OR ("startedAt" IS NOT NULL AND "dueAt" IS NOT NULL AND "dueAt" >= "startedAt")` [name: 'm2_retention_schedule']
  `(state = 'deleted') = ("completedAt" IS NOT NULL)` [name: 'm2_retention_completion']
  `char_length("basisCode") BETWEEN 1 AND 80` [name: 'm2_retention_basis']
 }
 Note: 'Una fila por recurso privado, solo dentro del mismo expediente/cuenta. dueAt se calcula por política y referencias legítimas; no es un temporizador arbitrario del cliente. anchorDecisionId puede cerrar cadena anterior o corrección archivada, sin editar outcome. startedAt toma evento de finalización pertinente, no primera finalizedAt de decisión. Conservación del mínimo estructural requiere la puerta jurídica/depuración de FK D08-R, no se finge implementada.'
}
Table marleva.M2MembershipRetentionHold {
 id uuid [pk, not null]
 caseId uuid [not null]
 createdBy uuid [not null]
 basisCode text [not null]
 caseReference text [not null]
 createdAt timestamptz [not null]
 reviewAt timestamptz [not null]
 releasedAt timestamptz
 releasedBy uuid
 revision integer [not null, default: 1]
 indexes { (caseId, releasedAt, reviewAt) [name: 'm2_hold_active_idx'] }
 checks {
  `"reviewAt" > "createdAt" AND revision > 0` [name: 'm2_hold_review']
  `("releasedAt" IS NULL AND "releasedBy" IS NULL) OR ("releasedAt" IS NOT NULL AND "releasedAt" >= "createdAt" AND "releasedBy" IS NOT NULL)` [name: 'm2_hold_release']
  `char_length("basisCode") BETWEEN 1 AND 80 AND char_length("caseReference") BETWEEN 1 AND 120` [name: 'm2_hold_basis']
 }
 Note: 'Causa legal/controversia documentada; referencia opaca sin relato ni adjuntos. ReviewAt es revisión obligatoria, nunca expiración silenciosa. No permite uso ordinario ni recuperar bytes borrados.'
}
Table marleva.M2MembershipDeletionTask {
 id uuid [pk, not null]
 caseId uuid [not null, unique]
 state text [not null, default: 'pending']
 leaseId uuid
 leaseUntil timestamptz
 fence bigint [not null, default: 0]
 attempts integer [not null, default: 0]
 nextAttemptAt timestamptz [not null]
 externalLedgerReference text
 completedAt timestamptz
 indexes { (state, nextAttemptAt, id) [name: 'm2_deletion_due_idx'] }
 checks {
  `(state = 'running' AND "leaseId" IS NOT NULL AND "leaseUntil" IS NOT NULL) OR (state <> 'running' AND "leaseId" IS NULL AND "leaseUntil" IS NULL)` [name: 'm2_deletion_running_lease']
  `state <> 'complete' OR "externalLedgerReference" IS NOT NULL` [name: 'm2_deletion_complete_ledger']
  `state IN ('pending','running','retry','complete') AND attempts >= 0 AND fence >= 0` [name: 'm2_deletion_state']
  `("leaseId" IS NULL) = ("leaseUntil" IS NULL)` [name: 'm2_deletion_lease']
  `(state = 'complete') = ("completedAt" IS NOT NULL)` [name: 'm2_deletion_complete']
 }
 Note: 'Intención durable; ledger externo confirmado antes de borrar. Un trabajador antiguo no confirma con fence/lease ajenos. Reintentar ausencia de todas las réplicas; fallos no reviven acceso.'
}
Table marleva.M2MembershipRetentionEvent {
 id uuid [pk, not null]
 caseId uuid [not null]
 actorId uuid
 eventType text [not null]
 commandId uuid [unique]
 commandKeyId text
 commandHash text [note: 'HMAC del cuerpo canónico, sin copiar contenido privado.']
 occurredAt timestamptz [not null]
 previousDueAt timestamptz
 resultingDueAt timestamptz
 reference text [not null]
 indexes { (caseId, occurredAt, id) [name: 'm2_retention_event_order_idx'] }
 checks {
  `("commandId" IS NULL AND "commandHash" IS NULL AND "commandKeyId" IS NULL) OR ("commandId" IS NOT NULL AND "commandHash" IS NOT NULL AND "commandKeyId" IS NOT NULL AND char_length("commandKeyId") BETWEEN 1 AND 80 AND btrim("commandKeyId") <> '' AND "commandHash" ~ '^[a-f0-9]{64}$' AND "actorId" IS NOT NULL)` [name: 'm2_retention_command_pair']
  `"eventType" IN ('finalized','challenged','scheduled','held','released','delete_intended','deleted','failed','restored_guard')` [name: 'm2_retention_event_type']
  `char_length(reference) BETWEEN 1 AND 120` [name: 'm2_retention_event_reference']
 }
 Note: 'Append-only por permisos/transacción futura. Guarda primera finalización y cambios de cómputo, sin motivo privado/cuerpo/hash del documento. actor nulo solo tarea técnica identificada por referencia.'
}
Table marleva.M2MembershipReplica {
 id uuid [pk, not null]
 caseId uuid [not null]
 replicaReference text [not null, unique]
 kind text [not null]
 registeredAt timestamptz [not null]
 purgeBy timestamptz [not null]
 absenceConfirmedAt timestamptz
 indexes { (caseId, absenceConfirmedAt) [name: 'm2_replica_case_idx'] }
 checks {
  `kind IN ('primary','backup','temporary','analysis')` [name: 'm2_replica_kind']
  `"purgeBy" >= "registeredAt" AND ("absenceConfirmedAt" IS NULL OR "absenceConfirmedAt" >= "registeredAt")` [name: 'm2_replica_dates']
 }
 Note: 'Inventario cerrado de todas las copias privadas, también copias de textos. Sin ubicación pública. Solo ausencia confirmada de todas permite completar borrado. No usar backup general no depurable para estas finalidades.'
}
Table marleva.M8MembershipReviewerProfile {
 accountId uuid [pk, not null]
 operationalLabel text [not null, unique]
 enabled boolean [not null, default: false]
 revision integer [not null, default: 1]
 updatedAt timestamptz [not null]
 checks {
  `"operationalLabel" ~ '^REV-[A-Z0-9]{6,12}$' AND revision > 0` [name: 'm8_reviewer_label']
 }
 Note: 'Etiqueta operativa M8 sin correo/nombre/domicilio. Perfil habilitado no concede capacidad: consultar grant vigente por envío y revalidar al asignar. Aprovisionamiento controlado con doble intervención antes del piloto; sin endpoint público de bootstrap ni cambio M1.'
}
Ref m2_retention_application: marleva.M2MembershipRetentionCase.(applicationId, accountId) > marleva.M2MembershipApplication.(id, accountId) [delete: no action, update: no action]
Ref m2_retention_anchor: marleva.M2MembershipRetentionCase.(anchorDecisionId, applicationId, accountId) > marleva.M2MembershipDecision.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_retention_document: marleva.M2MembershipRetentionCase.(documentId, applicationId, accountId, documentPurpose) > marleva.M2MembershipDocument.(id, applicationId, accountId, purpose) [delete: no action, update: no action]
Ref m2_retention_version: marleva.M2MembershipRetentionCase.(versionId, applicationId, accountId) > marleva.M2MembershipVersion.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_retention_decision: marleva.M2MembershipRetentionCase.(decisionId, applicationId, accountId) > marleva.M2MembershipDecision.(id, applicationId, accountId) [delete: no action, update: no action]
Ref m2_hold_case: marleva.M2MembershipRetentionHold.caseId > marleva.M2MembershipRetentionCase.id [delete: no action, update: no action]
Ref m2_hold_actor: marleva.M2MembershipRetentionHold.createdBy > marleva.Account.id [delete: no action, update: no action]
Ref m2_hold_releaser: marleva.M2MembershipRetentionHold.releasedBy > marleva.Account.id [delete: no action, update: no action]
Ref m2_deletion_case: marleva.M2MembershipDeletionTask.caseId > marleva.M2MembershipRetentionCase.id [delete: no action, update: no action]
Ref m2_retention_event_case: marleva.M2MembershipRetentionEvent.caseId > marleva.M2MembershipRetentionCase.id [delete: no action, update: no action]
Ref m2_retention_event_actor: marleva.M2MembershipRetentionEvent.actorId > marleva.Account.id [delete: no action, update: no action]
Ref m2_replica_case: marleva.M2MembershipReplica.caseId > marleva.M2MembershipRetentionCase.id [delete: no action, update: no action]
Ref m8_reviewer_profile_account: marleva.M8MembershipReviewerProfile.accountId > marleva.Account.id [delete: no action, update: no action]
TableGroup Conservacion_M2 {
 marleva.M2MembershipRetentionCase
 marleva.M2MembershipRetentionHold
 marleva.M2MembershipDeletionTask
 marleva.M2MembershipRetentionEvent
 marleva.M2MembershipReplica
}

Table marleva.M2SellerProfile {
 id uuid [pk, not null]
 applicationId uuid [not null]
 accountId uuid [not null]
 state text [not null, default: 'draft']
 revision integer [not null, default: 1]
 currentVersionId uuid
 approvedVersionId uuid
 isPaused boolean [not null, default: false]
 createdAt timestamptz [not null]
 updatedAt timestamptz [not null]
 indexes {
  (id,applicationId,accountId) [unique, name: 'm2sellerprofile_owner']
  (accountId) [unique, name: 'm2_one_seller_per_account']
 }
 checks {
  `state IN ('draft','pending','correction','enabled','rejected') AND revision > 0` [name: 'm2_seller_state']
  `"updatedAt" >= "createdAt"` [name: 'm2_seller_dates']
 }
 Note: 'Objetivo documental, no aplicado. Invariantes entre filas/autorización por transacción futura.'
}

Table marleva.M2SellerVersion {
 id uuid [pk, not null]
 applicationId uuid [not null]
 accountId uuid [not null]
 profileId uuid [not null]
 number integer [not null]
 origin text [not null]
 sourceDecisionId uuid
 previousVersionId uuid
 lifecycle text [not null, default: 'draft']
 displayName text
 description text
 attentionMode text
 responseMinutes integer
 serviceWindow text
 createdAt timestamptz [not null]
 submittedAt timestamptz
 indexes {
  (id,applicationId,accountId) [unique, name: 'm2sellerversion_owner']
  (id,profileId,applicationId,accountId) [unique, name: 'm2_seller_version_profile_key']
  (profileId,number) [unique, name: 'm2_seller_number']
 }
 checks {
  `number > 0 AND origin IN ('initial','correction','reconsideration','material_change') AND lifecycle IN ('draft','submitted')` [name: 'm2_seller_version_cycle']
  `(number = 1) = (origin = 'initial') AND ((origin = 'initial' AND "previousVersionId" IS NULL AND "sourceDecisionId" IS NULL) OR (origin <> 'initial' AND "previousVersionId" IS NOT NULL AND "sourceDecisionId" IS NOT NULL))` [name: 'm2_seller_initial']
  `"displayName" IS NULL OR (char_length("displayName") BETWEEN 1 AND 100 AND btrim("displayName") <> '')` [name: 'm2_seller_display']
  `description IS NULL OR char_length(description) BETWEEN 1 AND 1000` [name: 'm2_seller_description']
  `"attentionMode" IS NULL OR "attentionMode" IN ('private_location','customer_location','remote')` [name: 'm2_seller_attention']
  `"responseMinutes" IS NULL OR "responseMinutes" BETWEEN 1 AND 1440` [name: 'm2_seller_response']
  `"serviceWindow" IS NULL OR char_length("serviceWindow") BETWEEN 1 AND 500` [name: 'm2_seller_window']
  `(lifecycle = 'draft' AND "submittedAt" IS NULL) OR (lifecycle = 'submitted' AND "submittedAt" >= "createdAt" AND "submittedAt" IS NOT NULL AND "displayName" IS NOT NULL AND description IS NOT NULL AND "attentionMode" IS NOT NULL AND "responseMinutes" IS NOT NULL AND "serviceWindow" IS NOT NULL)` [name: 'm2_seller_submitted']
 }
 Note: 'Objetivo documental, no aplicado. Invariantes entre filas/autorización por transacción futura.'
}

Table marleva.M2SellerVersionPrivate {
 versionId uuid [pk, not null]
 profileId uuid [not null]
 applicationId uuid [not null]
 accountId uuid [not null]
 legalName text
 contractAddress text
 phone text
 supportHours text
 attentionAddress text
 reconsiderationReason text
 purgedAt timestamptz
 checks {
  `("legalName" IS NULL OR char_length("legalName") BETWEEN 1 AND 200) AND ("contractAddress" IS NULL OR char_length("contractAddress") BETWEEN 1 AND 1000) AND ("supportHours" IS NULL OR char_length("supportHours") BETWEEN 1 AND 500) AND ("attentionAddress" IS NULL OR char_length("attentionAddress") BETWEEN 1 AND 1000) AND ("reconsiderationReason" IS NULL OR (char_length("reconsiderationReason") BETWEEN 1 AND 2000 AND btrim("reconsiderationReason") <> ''))` [name: 'm2_seller_private_lengths']
  `phone IS NULL OR phone ~ '^\+[1-9][0-9]{7,14}$'` [name: 'm2_seller_phone']
  `"purgedAt" IS NULL OR ("legalName" IS NULL AND "contractAddress" IS NULL AND phone IS NULL AND "supportHours" IS NULL AND "attentionAddress" IS NULL AND "reconsiderationReason" IS NULL)` [name: 'm2_seller_private_purge']
 }
 Note: 'Objetivo documental, no aplicado. Invariantes entre filas/autorización por transacción futura.'
}

Table marleva.M2SellerCoverage {
 versionId uuid [not null]
 profileId uuid [not null]
 applicationId uuid [not null]
 accountId uuid [not null]
 developmentId integer [not null]
 indexes {
  (versionId,developmentId) [unique, name: 'm2sellercoverage_key']
 }
 checks {
  `"developmentId" BETWEEN 1 AND 7` [name: 'm2sellercoverage_value']
 }
 Note: 'Objetivo documental, no aplicado. Invariantes entre filas/autorización por transacción futura.'
}

Table marleva.M2SellerModality {
 versionId uuid [not null]
 profileId uuid [not null]
 applicationId uuid [not null]
 accountId uuid [not null]
 modality text [not null]
 indexes {
  (versionId,modality) [unique, name: 'm2sellermodality_key']
 }
 checks {
  `modality IN ('delivery','pickup','on_site','remote')` [name: 'm2sellermodality_value']
 }
