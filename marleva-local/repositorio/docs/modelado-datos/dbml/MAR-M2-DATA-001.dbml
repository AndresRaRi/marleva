Ref m2_receipt_document: marleva.M2MembershipCommandReceipt.(documentId, applicationId, accountId, documentPurpose) > marleva.M2MembershipDocument.(id, applicationId, accountId, purpose) [delete: no action, update: no action]
Ref m2_receipt_assignment: marleva.M2MembershipCommandReceipt.(assignmentId, submissionId, applicationId, accountId) > marleva.M8MembershipAssignment.(id, submissionId, applicationId, accountId) [delete: no action, update: no action]
Ref m2_receipt_decision: marleva.M2MembershipCommandReceipt.(decisionId, assignmentId, submissionId, applicationId, accountId, actorId) > marleva.M2MembershipDecision.(id, assignmentId, submissionId, applicationId, accountId, reviewerId) [delete: no action, update: no action]

