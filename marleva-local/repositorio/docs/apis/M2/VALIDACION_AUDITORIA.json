{
  "date": "2026-10-15",
  "timezone": "America/Merida",
  "chat": "MAR-CHAT-007",
  "scope": "UC M2 001-004/011, M8 001-002; coherencia documental del recorrido",
  "findings": [
    {
      "id": "MAR-M2-AUD-A01",
      "title": "Finalidad contradictoria",
      "correction": "M8SEQ002:S145 y ejemplos de decisión aún usaban pendiente de definición. Se alinean con provisional, comando de cierre separado y D08-R.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A02",
      "title": "Proyección privada contradictoria",
      "correction": "Version false con PII y VisibleDecision sin indicador propio eran aceptados por esquema. Se cierran condiciones de nulidad/declaración y se agrega private_data_available a decisión visible.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A03",
      "title": "Borrado incompatible con integridad",
      "correction": "El documento válido exigía hash/objeto después de purgarlos. CHECKs distinguen evidencia disponible de veredicto técnico histórico; deleted limpia referencias/huellas. Purga privada reinicia declaración.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A04",
      "title": "Tareas/calendario incompletos",
      "correction": "scheduled/delete_pending/error/deleted requieren calendario; completed respeta vencimiento. running exige lease y complete referencia de ledger externo; no se afirma garantía entre proveedores.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A05",
      "title": "Órdenes de bloqueo distintos",
      "correction": "Envío, revisión y política usaban órdenes diferentes. Se normaliza expediente→casos→concesiones→documentos→versiones/enlaces→envíos/asignaciones→bloqueos/tareas, conservando IDs.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A06",
      "title": "Acciones de pantalla heredadas",
      "correction": "Borrador preparado no vuelve a preparar; respuesta incierta consulta; vacío inicia solicitud; carga espera; pérdida de permiso vuelve. state_actions es fuente canónica por vista.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A07",
      "title": "Origen del envío y resultado M8",
      "correction": "Se agregan vistas de envío de corrección/reconsideración y resultado de corrección confirmado; resultados M8 cierran acciones de decidir. Revisión inicial no muestra motivo de reconsideración.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A08",
      "title": "Pruebas genéricas incorrectas",
      "correction": "La transferencia es204 sin JSON y own/creación de B no es404 ajeno. Se concretan fixtures/pasos, escenarios de UI y negativos/recuperación para23 operaciones.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A09",
      "title": "Trazabilidad y pendientes desactualizados",
      "correction": "Se enlazan pasos de conservación en contratos propios; D05/D06 ya tienen propuesta del recorrido. Se separan pendientes reales de integración/aceptación/otros recorridos.",
      "status": "corregido_documentalmente"
    },
    {
      "id": "MAR-M2-AUD-A10",
      "title": "Ejemplos temporales y privacidad",
      "correction": "Se alinea fecha del resumen con su envío anidado; se rechazan estados final sin fecha, provisional con fecha y pendiente de borrado como complete. Todas las verificaciones son documentales.",
      "status": "corregido_documentalmente"
    }
  ],
