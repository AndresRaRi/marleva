generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  schemas = ["marleva"]
}
model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId String @unique @db.Uuid
  email String @unique
  state String @default("active")
  operator Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz
  privateFixtures PrivateFixture[]
  sessions Session[]
  notices Notice[]
  emailChanges EmailChange[]
  @@schema("marleva")
}
model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  tokenHash String @unique
  csrfHash String
  providerTokens String
  createdAt DateTime @default(now()) @db.Timestamptz
  lastSeen DateTime @default(now()) @db.Timestamptz
  authenticatedAt DateTime @default(now()) @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  refreshLease DateTime? @db.Timestamptz
  fixtureAccess FixtureAccess[]
  @@unique([id, accountId], map: "Session_id_accountId_key")
  @@schema("marleva")
}
model Challenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String
  origin String
  state String @default("sending")
  attempts Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
  expiresAt DateTime @db.Timestamptz
  blockedUntil DateTime? @db.Timestamptz
  @@index([email, createdAt])
  @@index([origin, createdAt])
  @@schema("marleva")
}
model EmailChange {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oldEmail String
  newEmail String
  providerTokens String
  oldConfirmed Boolean @default(false)
  newConfirmed Boolean @default(false)
  state String @default("sending")
  createdAt DateTime @default(now()) @db.Timestamptz
  expiresAt DateTime @db.Timestamptz
  attempts Int @default(0)
  @@index([accountId, state])
  @@schema("marleva")
}
model Notice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  kind String
  text String
  createdAt DateTime @default(now()) @db.Timestamptz
  @@index([accountId, createdAt, id])
  @@schema("marleva")
}
model Outbox {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference String @unique
  recipient String
  subject String
  text String
  state String @default("pending")
  attempts Int @default(0)
  dueAt DateTime @default(now()) @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  @@schema("marleva")
}
model Audit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String? @db.Uuid
  action String
  resourceId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  @@schema("marleva")
}
model Development {
  id Int @id
  name String @unique
  @@schema("marleva")
}

model PrivateFixture {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  objectKey String @unique
  sha256 String
  mimeType String @default("text/plain")
  bytes Int
  state String @default("available")
  createdAt DateTime @default(now()) @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  deleteRequestedAt DateTime? @db.Timestamptz
  version Int @default(1)
  access FixtureAccess[]
  deletions FixtureDeletion[]
  @@unique([id, accountId], map: "PrivateFixture_id_accountId_key")
  @@schema("marleva")
}

model FixtureAccess {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixtureId String @db.Uuid
  accountId String @db.Uuid
  sessionId String @db.Uuid
  tokenHash String @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  expiresAt DateTime @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  fixture PrivateFixture @relation(fields: [fixtureId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction)
  session Session @relation(fields: [sessionId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction)
  @@index([sessionId, createdAt])
  @@schema("marleva")
}

model FixtureDeletion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fixtureId String @unique @db.Uuid
  accountId String @db.Uuid
  idempotencyKey String
  requestHash String
  expectedVersion Int
  state String @default("pending")
  attempts Int @default(0)
  dueAt DateTime @default(now()) @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  completedAt DateTime? @db.Timestamptz
  fixture PrivateFixture @relation(fields: [fixtureId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction)
  @@unique([accountId, idempotencyKey])
  @@schema("marleva")
}

enum RoleKey {
 m1_operator
 m1_access_admin
 @@schema("marleva")
}
enum RecoveryState {
 requested
 approved
 executing
 provider_pending
 reenrollment
 completed
 rejected
 expired
 @@schema("marleva")
}
model RoleAssignment {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @db.Uuid
 role RoleKey
 grantedBy String? @db.Uuid
 grantedAt DateTime @default(now()) @db.Timestamptz
 revokedBy String? @db.Uuid
 revokedAt DateTime? @db.Timestamptz
 reason String
 version Int @default(1)
 @@index([accountId, role, revokedAt])
 @@schema("marleva")
}
model MfaRecovery {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 accountId String @db.Uuid
 requestedBy String @db.Uuid
 approvedBy String? @db.Uuid
 state RecoveryState @default(requested)
 reason String
 providerReference String?
 requestKey String
 requestHash String
 approvedAt DateTime? @db.Timestamptz
 operations Json @default("{}")
 providerState Json @default("{}")
 leaseToken String? @db.Uuid
 leaseUntil DateTime? @db.Timestamptz
 capabilitySessionId String? @db.Uuid
 capabilityExpiresAt DateTime? @db.Timestamptz
 capabilityAttempts Int @default(0)
 capabilityConsumedAt DateTime? @db.Timestamptz
 factorId String? @db.Uuid
 capabilityHash String?
 createdAt DateTime @default(now()) @db.Timestamptz
 expiresAt DateTime @db.Timestamptz
 completedAt DateTime? @db.Timestamptz
 version Int @default(1)
 @@unique([accountId, requestKey])
 @@index([accountId, state])
 @@schema("marleva")
}
