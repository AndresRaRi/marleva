{
  "expo": {
    "name": "Marleva local",
    "slug": "marleva-local",
    "scheme": "marleva",
    "version": "0.1.0",
    "platforms": ["android", "ios", "web"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/local-debug-tls.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "mx.marleva.local"
    },
    "ios": {
      "bundleIdentifier": "mx.marleva.local"
    },
    "extra": {
      "apiOrigin": "https://localhost:8443"
    }
  }
}
